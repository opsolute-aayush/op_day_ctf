generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row (id always 1) holding global game state — start/pause/finish
// and who won. Puzzle content itself (levels, sentence) lives per-team below.
model GameConfig {
  id            Int       @id @default(1)
  isActive      Boolean   @default(false)
  isFinished    Boolean   @default(false)
  winningTeamId String?
  winningTeam   Team?     @relation("WinningTeam", fields: [winningTeamId], references: [id])
  startedAt     DateTime?
  updatedAt     DateTime  @updatedAt
}

model Team {
  id              String        @id @default(uuid())
  teamNumber      Int           @unique // fixed slot assigned by the admin; never reused after a delete
  name            String        // player-chosen display name — freely editable, not required to be unique
  color           String        @default("#39FF14")
  members         String // JSON string array
  winningSentence String        @default("") // this team's own final sentence — unique per team
  createdAt       DateTime      @default(now())
  progress        TeamProgress?
  levels          LevelConfig[]
  activity        ActivityLog[]
  wonGame         GameConfig[]  @relation("WinningTeam")
}

// Levels 1..N-1 require a password + reveal a location clue + award a word.
// The implicit final level (N) is the sentence-assembly stage and has no row here.
// Every row belongs to exactly one team — each team has its own independent
// set of passwords/clues/words and its own final sentence (on Team above).
model LevelConfig {
  id           Int      @id @default(autoincrement())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  levelNumber  Int
  password     String // bcrypt hash
  locationClue String
  wordReward   String
  hint         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teamId, levelNumber])
}

model TeamProgress {
  id                String    @id @default(uuid())
  teamId            String    @unique
  team              Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  currentLevel      Int       @default(1)
  unlockedLevels    String    @default("[0]") // JSON int array
  collectedWords    String    @default("[]") // unused — kept for compatibility; see verifiedWordLevels
  verifiedWordLevels String   @default("[]") // JSON int array — levels whose physical word has been typed in and confirmed
  hintReleasedLevel Int? // level number a hint has been released for (self-service or admin)
  helpCreditsRemaining Int  @default(2) // self-service "Help" button uses left this game
  completed         Boolean   @default(false)
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  eventType String // LEVEL_UNLOCKED | WRONG_PASSWORD | WIN | GAME_STARTED | GAME_PAUSED | GAME_RESET | FORCE_UNLOCK | TEAM_REGISTERED
  details   String? // JSON string
  createdAt DateTime @default(now())
}
